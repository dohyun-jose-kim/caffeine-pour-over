#!/bin/zsh
# nosleep — 시간 제한부 슬립 방지 (pmset disablesleep, auto-revert)
#
# sudo는 /etc/sudoers.d/nosleep 의 NOPASSWD 규칙에 의존한다 (install.sh가 설치).
# 백그라운드 watcher가 비밀번호 없이 disablesleep을 되돌릴 수 있어야 하기 때문.
set -u

# macOS의 $TMPDIR은 사용자 전용 디렉터리(drwx------)라 전역 쓰기 가능한 /tmp와 달리
# 남이 state를 조작해 엉뚱한 PID를 kill시키는 경로가 없다.
STATE_FILE=${TMPDIR:-/tmp}/nosleep.state   # 형식: "<end_epoch> <watcher_pid> <nonce>"
LOG_FILE=${TMPDIR:-/tmp}/nosleep.log       # 되돌림 실패만 기록 (정상 동작은 무기록)

# watcher 신원 확인용. zsh는 함수 안에서 $0이 함수명이 되므로 톱레벨에서 잡아둔다.
SELF=${0:t}

die() { print -u2 "nosleep: $1"; exit 1 }

usage() {
  cat <<'EOF'
Usage: nosleep [duration|command]

  nosleep              60분 동안 슬립 방지
  nosleep 90           90분 (단위 없으면 분)
  nosleep 1h30m        h/m/s 조합 (예: 2h, 45s, 1h30m20s)
  nosleep status       남은 시간과 pmset 상태 확인
  nosleep extend 30m   종료 시각 연장
  nosleep cancel       즉시 해제
EOF
}

# duration 문자열 -> 초 (stdout). 실패 시 1 리턴.
parse_duration() {
  local in=$1
  if [[ $in == <-> ]]; then
    (( in > 0 )) || return 1
    print $(( in * 60 ))
    return 0
  fi
  if [[ -n $in && $in =~ '^([0-9]+h)?([0-9]+m)?([0-9]+s)?$' ]]; then
    local h=${match[1]%h} m=${match[2]%m} s=${match[3]%s}
    local total=$(( ${h:-0} * 3600 + ${m:-0} * 60 + ${s:-0} ))
    (( total > 0 )) && { print $total; return 0 }
  fi
  return 1
}

# 초 -> "MM:SS" 또는 "H:MM:SS"
fmt_hms() {
  local t=$1
  if (( t >= 3600 )); then
    printf '%d:%02d:%02d' $(( t / 3600 )) $(( t % 3600 / 60 )) $(( t % 60 ))
  else
    printf '%02d:%02d' $(( t / 60 )) $(( t % 60 ))
  fi
}

# 상태 파일을 읽어 END_EPOCH / WATCHER_PID / NONCE 설정.
# 없거나 깨졌으면(구버전의 2필드 포맷 포함) 1 리턴.
read_state() {
  [[ -f $STATE_FILE ]] || return 1
  read -r END_EPOCH WATCHER_PID NONCE < $STATE_FILE 2>/dev/null || return 1
  [[ ${END_EPOCH:-} == <-> && ${WATCHER_PID:-} == <-> && -n ${NONCE:-} ]]
}

# state를 원자적으로 교체한다. 그냥 리다이렉트로 덮어쓰면 watcher가 잘린 파일을
# 읽을 수 있다.
write_state() {
  local end=$1 pid=$2 nonce=$3 tmp
  tmp=$(mktemp "${STATE_FILE}.XXXXXX") || return 1
  print "$end $pid $nonce" > $tmp && mv -f $tmp $STATE_FILE
}

new_nonce() { print "${RANDOM}${RANDOM}$(date +%s)" }

# PID가 살아 있고, 그게 정말 nosleep watcher인지까지 확인한다.
# watcher가 비정상 종료된 뒤 PID가 재사용되면 kill이 무관한 프로세스를 죽인다.
watcher_alive() {
  kill -0 $WATCHER_PID 2>/dev/null || return 1
  [[ $(ps -p $WATCHER_PID -o command= 2>/dev/null) == *$SELF* ]]
}

sleep_disabled() { [[ $(pmset -g | awk '/SleepDisabled/{print $2}') == 1 ]] }

# end_epoch까지 기다렸다가 슬립을 복구하는 watcher를 띄우고 PID를 출력.
# stdout/stderr를 끊어야 $(...) 캡처가 watcher 종료까지 매달리지 않는다.
spawn_watcher() {
  local end=$1 nonce=$2
  (
    trap '' HUP
    sleep $(( end - $(date +%s) ))
    # 자고 일어나는 사이에 cancel/extend/새 세션이 주인을 바꿨을 수 있다.
    # nonce가 내 것이 아니면 지금 슬립을 끄는 건 남의 세션을 깨는 짓이다.
    read_state && [[ $NONCE == $nonce ]] || exit 0
    if sudo -n pmset -a disablesleep 0; then
      rm -f $STATE_FILE
      osascript -e 'display notification "Sleep re-enabled" with title "nosleep"'
    else
      # 복구 실패를 조용히 넘기면 "알림이 안 왔다"와 "아직 안 끝났다"를
      # 구분할 수 없다. state는 일부러 남긴다 — status가 계속 ⚠를 띄워야 한다.
      print -r -- "$(date '+%F %T') revert FAILED — sudo -n pmset (sudoers 규칙 확인)" >> $LOG_FILE
      osascript -e 'display notification "복구 실패 — sudo pmset -a disablesleep 0 을 직접 실행하세요" with title "nosleep ⚠"'
    fi
  ) >/dev/null 2>&1 &!
  print $!
}

kill_watcher() {
  read_state && watcher_alive && kill $WATCHER_PID 2>/dev/null
}

cmd_start() {
  local secs
  secs=$(parse_duration $1) || die "잘못된 시간: '$1' (예: 90, 90m, 45s, 1h30m)"
  # pmset이 성공한 뒤에 기존 watcher를 교체한다. 순서가 반대면 시작에 실패했을 때
  # 이전 세션의 auto-revert만 사라지고 슬립은 꺼진 채로 남는다.
  sudo -n pmset -a disablesleep 1 \
    || die "sudo 비밀번호가 필요합니다 — install.sh를 한 번 실행해 NOPASSWD 규칙을 설치하세요"
  kill_watcher
  local end=$(( $(date +%s) + secs ))
  local nonce=$(new_nonce)
  # nonce를 먼저 기록해야 짧은 타이머(nosleep 1s)에서 watcher가 state보다 먼저
  # 깨어나 자기 것을 못 찾고 그냥 빠져나가는 일이 없다. pid는 spawn 후 채운다.
  write_state $end 0 $nonce || die "state 파일을 쓸 수 없습니다: $STATE_FILE"
  local pid=$(spawn_watcher $end $nonce)
  write_state $end $pid $nonce
  print "🚫💤 Sleep disabled for $(fmt_hms $secs) — until $(date -r $end +%H:%M:%S)"
}

# 종료 코드: 0=활성, 1=비활성, 2=watcher 없이 disablesleep이 켜져 있음(⚠)
cmd_status() {
  local rc=1
  if read_state && watcher_alive; then
    rc=0
    local remain=$(( END_EPOCH - $(date +%s) ))
    (( remain < 0 )) && remain=0
    print "✓ active — $(fmt_hms $remain) remaining (until $(date -r $END_EPOCH +%H:%M:%S), watcher PID $WATCHER_PID)"
  else
    print "✗ no active nosleep"
  fi
  if sleep_disabled; then
    print "  pmset SleepDisabled: 1"
    if ! { read_state && watcher_alive }; then
      print -u2 "  ⚠ watcher 없이 슬립이 꺼져 있음 — 'nosleep cancel'로 복구하세요"
      rc=2
    fi
  else
    print "  pmset SleepDisabled: 0"
  fi
  return $rc
}

cmd_extend() {
  local secs
  secs=$(parse_duration $1) || die "잘못된 시간: '$1' (예: 30m, 1h)"
  read_state && watcher_alive || die "연장할 활성 nosleep이 없습니다"
  kill $WATCHER_PID 2>/dev/null
  local end=$(( END_EPOCH + secs ))
  local nonce=$(new_nonce)   # 새 nonce로 교체 → 옛 watcher는 깨어나도 빠져나간다
  write_state $end 0 $nonce || die "state 파일을 쓸 수 없습니다: $STATE_FILE"
  local pid=$(spawn_watcher $end $nonce)
  write_state $end $pid $nonce
  print "⏩ extended — $(fmt_hms $(( end - $(date +%s) ))) remaining (until $(date -r $end +%H:%M:%S))"
}

cmd_cancel() {
  kill_watcher
  rm -f $STATE_FILE
  sudo -n pmset -a disablesleep 0 \
    || die "sudo 비밀번호가 필요합니다 — 'sudo pmset -a disablesleep 0'을 직접 실행하세요"
  print "✓ canceled — sleep re-enabled now"
}

case ${1:-} in
  status)         cmd_status ;;
  cancel|off)     cmd_cancel ;;
  extend)         cmd_extend ${2:-} ;;
  help|-h|--help) usage ;;
  '')             cmd_start 60 ;;
  *)              cmd_start $1 ;;
esac
